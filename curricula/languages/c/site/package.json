{
  "name": "@t3lm/site-c",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ../../../../tools/sw.mjs .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "smoke": "vite build --ssr scripts/ssr-check.tsx --outDir .ssr --logLevel error && node .ssr/ssr-check.js",
    "swcheck": "node ../../../../tools/swcheck.mjs .",
    "assets": "node ../../../../tools/assets.mjs .",
    "icons": "node ../../../../tools/icons.mjs .",
    "fonts": "node ../../../../tools/fonts.mjs . \"https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Source+Code+Pro:wght@400;500;600;700&display=swap\"",
    "runno": "vite build --mode runno --outDir .runno --logLevel error && node scripts/runnable.mjs",
    "wasm": "node ../../../../tools/wasm.mjs ."
  },
  "dependencies": {
    "@runno/runtime": "^0.10.0",
    "@t3lm/kit": "*",
    "lucide-react": "^1.33.0",
    "marked": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
